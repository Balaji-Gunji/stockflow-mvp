<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products | StockFlow</title>
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

    <header class="navbar">
        <a href="/dashboard" class="brand">StockFlow</a>

        <div class="nav-user">
            <span>
                <%= user.organization_name %>
            </span>

            <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <button type="submit" class="btn-logout">
                    Logout
                </button>
            </form>
        </div>
    </header>

    <nav class="navigation">
        <a href="/dashboard">Dashboard</a>
        <a href="/products" class="active">Products</a>
        <a href="/settings">Settings</a>
    </nav>

    <main class="container">

        <div class="page-header">
            <div>
                <h1>Products</h1>
                <p>Manage your organization's inventory.</p>
            </div>

            <a href="/products/add" class="btn-primary">
                + Add Product
            </a>
        </div>

        <form action="/products" method="GET" class="search-form">

            <input type="text" name="search" placeholder="Search by product name or SKU..." value="<%= search %>">

            <button type="submit" class="btn-primary">
                Search
            </button>

            <% if (search) { %>
                <a href="/products" class="btn-secondary">
                    Clear
                </a>
                <% } %>

        </form>

        <div class="table-card">

            <% if (products.length===0) { %>

                <div class="empty-state">

                    <% if (search) { %>

                        <h3>No matching products found</h3>
                        <p>Try searching with a different name or SKU.</p>

                        <a href="/products" class="btn-secondary">
                            Clear Search
                        </a>

                        <% } else { %>

                            <h3>No products yet</h3>
                            <p>Add your first product to start managing inventory.</p>

                            <a href="/products/add" class="btn-primary">
                                Add Product
                            </a>

                            <% } %>

                </div>

                <% } else { %>

                    <div class="table-responsive">

                        <table>
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>SKU</th>
                                    <th>Quantity</th>
                                    <th>Cost Price</th>
                                    <th>Selling Price</th>
                                    <th>Threshold</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% products.forEach(product=> { %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= product.name %>
                                            </strong>

                                            <% if (product.description) { %>
                                                <div class="product-description">
                                                    <%= product.description %>
                                                </div>
                                                <% } %>
                                        </td>

                                        <td>
                                            <%= product.sku %>
                                        </td>

                                        <td>
                                            <%= product.quantity %>
                                        </td>

                                        <td>
                                            <%= product.cost_price !=null ? Number(product.cost_price).toFixed(2) : '—'
                                                %>
                                        </td>

                                        <td>
                                            <%= product.selling_price !=null ? Number(product.selling_price).toFixed(2)
                                                : '—' %>
                                        </td>

                                        <td>
                                            <%= product.effective_threshold %>
                                        </td>

                                        <td>

                                            <% if (product.quantity <=product.effective_threshold) { %>

                                                <span class="badge badge-low">
                                                    Low Stock
                                                </span>

                                                <% } else { %>

                                                    <span class="badge badge-success">
                                                        In Stock
                                                    </span>

                                                    <% } %>

                                        </td>

                                        <td>
                                            <div class="action-buttons">

                                                <a href="/products/edit/<%= product.id %>" class="btn-edit">
                                                    Edit
                                                </a>

                                                <form action="/products/delete/<%= product.id %>" method="POST"
                                                    class="delete-form">

                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                    <button type="submit" class="btn-delete">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>
                                        </td>

                                    </tr>

                                    <% }); %>

                            </tbody>
                        </table>

                    </div>

                    <div class="results-count">
                        Showing <%= products.length %>
                            product<%= products.length===1 ? '' : 's' %>
                    </div>

                    <% } %>

        </div>

    </main>

    <script src="/js/products.js" defer></script>

</body>

</html>